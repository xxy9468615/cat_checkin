# --- AI-ROUTER (ai_router.py) ---
# 企业级 AI 网关每日签到（奖励：$1 基础 + 昨日消费 2%，上限 $10）
# 模式一（最推荐，永久免维护）：账号密码自动登录，Token 失效自动重新换取并存入 Redis
#   多账号序列：AI_ROUTER_EMAIL_1, AI_ROUTER_PASSWORD_1 / AI_ROUTER_EMAIL_2, AI_ROUTER_PASSWORD_2
#   传统格式：AI_ROUTER_ACCOUNTS（email:password，&& 分隔）
# 模式二（Token 模式）：AI_ROUTER_REFRESH_TOKEN（自动轮转续期 + Upstash Redis 云端持久化保存）
AI_ROUTER_EMAIL_1=
AI_ROUTER_PASSWORD_1=
AI_ROUTER_EMAIL_2=
AI_ROUTER_PASSWORD_2=
AI_ROUTER_EMAIL=
AI_ROUTER_PASSWORD=
AI_ROUTER_ACCOUNTS=
AI_ROUTER_REFRESH_TOKEN=
AI_ROUTER_TOKEN=
AI_ROUTER_COOKIE=
# AI_ROUTER_API_URL=https://api.ai-router.dev/api/v1

# --- Latvi (latvi.py) — 24小时动态窗口（单 run 内联） ---
# 单 run 模式：窗口 = 上次成功签到 + 24h（状态驱动，无随机 margin），由 daily_orchestrator
# 动态推算今日窗口并提前 2min 进场，冷却重试循环精确收尾；窗口晚于 19:30 则今日跳过次日重锚
LATVI_EMAIL_1=
LATVI_PASSWORD_1=
LATVI_email=
LATVI_password=
# LATVI_STATE_FILE=.latvi_state.json
# LATVI_NO_RELAY=1                       # 单 run 内联模式（orchestrator 注入），关闭 QStash 延时接力

# --- AgentRouter (agentrouter.py) ---
# 多账号序列：AGENTROUTER_EMAIL_1, AGENTROUTER_PASSWORD_1 / AGENTROUTER_EMAIL_2, AGENTROUTER_PASSWORD_2
# 传统格式：AGENTROUTER_ACCOUNTS（email:password，&& 分隔）
AGENTROUTER_EMAIL_1=
AGENTROUTER_PASSWORD_1=
AGENTROUTER_EMAIL_2=
AGENTROUTER_PASSWORD_2=
AGENTROUTER_EMAIL=
AGENTROUTER_PASSWORD=
AGENTROUTER_ACCOUNTS=
# AGENTROUTER_API_URL=https://ps.air-outer.com
# AGENTROUTER_PROXY=socks5://127.0.0.1:1080  # SOCKS5 代理出口（CI 由 workflow 注入；仅本地经代理调试时手动设）
# AGENTROUTER_STATE_FILE=.agentrouter_state.json

