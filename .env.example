# =====================================================================
# cat_checkin 环境变量模板  ——  复制为 .env 后填写，仅填你用到的项
# 值为空的项需要你填入才生效。CI 环境通过 GitHub Secrets 传入。
# ---------------------------------------------------------------------
# 注意：手动 parser 不会 strip 行内 # 注释，secret 行末不要放 # 尾注。
# =====================================================================

# ---------------------------------------------------------------------
# 运行时 (CI 不使用，仅本地调试时参考)
# ---------------------------------------------------------------------
TZ=Asia/Shanghai
# DEBUG=true

# ---------------------------------------------------------------------
# Telegram 汇总推送
# ---------------------------------------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_USER_ID=                  # 可替代 TG_CHAT_ID
# TG_API_HOST=https://api.telegram.org

# PushDeer 推送 (glados 任务可选)
# PUSHDEER_SENDKEY=

# ---------------------------------------------------------------------
# 每日签到任务调度 (daily_report.py)
# ---------------------------------------------------------------------
DAILY_PUSH=true
DAILY_EXCLUDE=birdiesearch.py,latvi.py
DAILY_TIMEOUT=180
DAILY_MAX_TASK_OUTPUT=1500

# ---------------------------------------------------------------------
# 各签到站点凭证（按需填写，未启用的站点留空即可）
# 多账号：&& 或换行分隔
# =====================================================================

# --- GLaDOS (glados.py) ---
# 多账号：每组以 && 分隔；关键字段：koa:sess + koa:sess.sig
GLADOS_COOKIES=
GLADOS_EXCHANGE_PLAN=plan500
GLADOS_AUTO_EXCHANGE=true
GLADOS_DOMAINS=glados.cloud

# --- 2Libra (2libra.py) ---
# 多账号：&& 或换行分隔，格式：cookie|authorization(可选)
2LIBRA_COOKIES=

# --- 飞牛私有云 (fnnas_club.py) ---
FNNAS_cookie=

# --- 边界 AI (bianjie_ai.py) ---
# 多账号：每行 "user:pass"，账号间换行或 && 分隔
BIANJIE_AI_ACCOUNTS=

# --- moxing.vip (moxing_vip.py) ---
MOXING_username=
MOXING_password=
MOXING_Domain=https://moxing.vip
# MOXING_UA=

# --- DJI 大疆社区 (dji.py) ---
DJI_cookie=

# --- 绿联私有云 (ugnas_club.py) ---
UGNAS_cookie=

# --- Latvi (latvi.py) — 独立 workflow，此处仅作本地调试参考 ---
LATVI_email=
LATVI_password=

# --- 远景论坛 (pcbeta.py) ---
PCBETA_username=
PCBETA_password=

# --- 腾讯 CloudStudio (tencent_cloudstudio.py) ---
CLOUDSTUDIO_cookie=
CLOUDSTUDIO_xsrf=

# --- 奶昔论坛 (naixi_forum.py) ---
NAIXI_username=
NAIXI_password=

# --- MonkeyCode (monkeycode.py) ---
MONKEYCODE_cookie=

# --- Sophnet (sophnet.py) ---
# 多账号：token|refreshToken，&& 或换行分隔；token 可留空，脚本会用 refresh_token 续期
SOPHNET_TOKENS=
